#!/usr/bin/env bash
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
HOOK="$REPO_ROOT/hooks/launch-local-coder"

FAILURES=0
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf "$TEST_ROOT"' EXIT
pass() { echo "  [PASS] $1"; }
fail() { echo "  [FAIL] $1"; FAILURES=$((FAILURES + 1)); }

# The launch hook takes the plugin-data dir as its FIRST arg and server.py as
# its SECOND. It calls hooks/ensure-local-coder-venv FIRST (so a fresh install
# connects on the first session regardless of SessionStart ordering), then
# execs the venv python. The data dir is passed via ${CLAUDE_PLUGIN_DATA}
# substitution in .mcp.json args (NOT the env var), because Claude Code
# substitutes that placeholder into the MCP command's argv but does NOT
# reliably export it to the server subprocess (verified in a real smoke test).

# Helper: make a fake venv (already present) so ensure-venv's fast path
# no-ops and launch proceeds straight to exec, without a real pip install.
make_fake_venv() {
    local data="$1" req="$REPO_ROOT/mcp-servers/local-coder/requirements.txt"
    mkdir -p "$data/local-coder/.venv/bin"
    # Must satisfy ensure-venv's version probe (`-c "import sys; ..."`) so
    # the fast path treats it as usable, AND echo its arg so launch tests
    # can assert what it was exec'd with.
    cat > "$data/local-coder/.venv/bin/python" <<'FAKE'
#!/usr/bin/env bash
if [ "$1" = "-c" ]; then exit 0; fi
echo "FAKE_PY_RAN arg=$1"
echo "FAKE_PY_DATA=${CLAUDE_PLUGIN_DATA:-<unset>}"
FAKE
    chmod +x "$data/local-coder/.venv/bin/python"
    # A stamp matching requirements.txt makes ensure-venv's fast path a no-op.
    cp "$req" "$data/local-coder/requirements.installed.txt"
}

# --- Test 1: venv present → execs the fake python on the server.py arg ---
DATA1="$TEST_ROOT/data1"; make_fake_venv "$DATA1"
OUT="$(bash "$HOOK" "$DATA1" /some/server.py 2>&1)"; RC=$?
if [ "$RC" -eq 0 ] && printf '%s' "$OUT" | grep -q "FAKE_PY_RAN arg=/some/server.py"; then
    pass "execs the venv python on the server.py arg"
else
    fail "execs the venv python on the server.py arg (rc=$RC out=$OUT)"
fi

# --- Test 2: uses the data-dir ARG, not the CLAUDE_PLUGIN_DATA env var ---
DATA2="$TEST_ROOT/data2"; make_fake_venv "$DATA2"
OUT="$(CLAUDE_PLUGIN_DATA="$TEST_ROOT/wrong-empty" bash "$HOOK" "$DATA2" /some/server.py 2>&1)"; RC=$?
if [ "$RC" -eq 0 ] && printf '%s' "$OUT" | grep -q "FAKE_PY_RAN arg=/some/server.py"; then
    pass "uses the data-dir ARG, not the CLAUDE_PLUGIN_DATA env var"
else
    fail "uses the data-dir ARG, not the CLAUDE_PLUGIN_DATA env var (rc=$RC out=$OUT)"
fi

# --- Test 2b: exports CLAUDE_PLUGIN_DATA into the server process ---
# server.py resolves config.yaml + per-call logs via plugin_data_dir(),
# which reads the CLAUDE_PLUGIN_DATA *env var*. The launcher receives the
# dir as argv, so it must export it — otherwise the server silently falls
# back to the in-tree dir under ${CLAUDE_PLUGIN_ROOT}, which plugin
# updates wipe (the exact failure this feature exists to prevent).
DATA2B="$TEST_ROOT/data2b"; make_fake_venv "$DATA2B"
OUT="$(env -u CLAUDE_PLUGIN_DATA bash "$HOOK" "$DATA2B" /some/server.py 2>&1)"; RC=$?
if printf '%s' "$OUT" | grep -q "FAKE_PY_DATA=$DATA2B"; then
    pass "exports CLAUDE_PLUGIN_DATA to the server process"
else
    fail "exports CLAUDE_PLUGIN_DATA to the server process (out=$OUT)"
fi

# --- Test 3: cannot provision AND no venv → exit 1 with a clear message ---
# PATH with shell/coreutils but NO python, so ensure-venv genuinely reaches
# its Python-discovery branch and fails there. An empty PATH would instead
# break the launcher on its own `bash`/`dirname` calls and prove nothing.
BASH_BIN="$(command -v bash)"
NOPY_BIN="$TEST_ROOT/nopy-bin"; mkdir -p "$NOPY_BIN"
for tool in bash dirname cat cmp mkdir rm cp seq sleep kill pwd; do
    src="$(command -v "$tool" 2>/dev/null)" && ln -sf "$src" "$NOPY_BIN/$tool"
done
DATA3="$TEST_ROOT/data3"; mkdir -p "$DATA3"
OUT="$(env -i PATH="$NOPY_BIN" "$BASH_BIN" "$HOOK" "$DATA3" /some/server.py 2>&1)"; RC=$?
if [ "$RC" -eq 1 ]; then pass "unprovisionable venv exits 1"; else fail "unprovisionable venv exits 1 (got $RC)"; fi
if printf '%s' "$OUT" | grep -q "venv"; then pass "unprovisionable venv prints a clear reason"; else fail "unprovisionable venv prints a clear reason"; fi

# --- Test 4: empty data-dir arg (and no env fallback) → exit 1 ---
OUT="$(env -u CLAUDE_PLUGIN_DATA bash "$HOOK" "" /some/server.py 2>&1)"; RC=$?
if [ "$RC" -eq 1 ] && printf '%s' "$OUT" | grep -q "data"; then
    pass "empty data-dir arg exits 1 with a clear reason"
else
    fail "empty data-dir arg exits 1 with a clear reason (rc=$RC out=$OUT)"
fi

# --- Test 5: empty server.py arg → exit 1 ---
DATA5="$TEST_ROOT/data5"; make_fake_venv "$DATA5"
OUT="$(bash "$HOOK" "$DATA5" "" 2>&1)"; RC=$?
if [ "$RC" -eq 1 ]; then pass "empty server.py arg exits 1"; else fail "empty server.py arg exits 1 (got $RC)"; fi

# --- Test 5b: a FAILED refresh must not launch the stale venv ---
# A venv exists, but requirements.txt has changed and the reinstall fails.
# The launcher previously ignored the provisioner's exit status (`|| true`)
# and exec'd the stale interpreter anyway — starting the server against
# dependencies that no longer match requirements.txt.
DATA5B="$TEST_ROOT/data5b"; make_fake_venv "$DATA5B"
# Stale stamp → ensure-venv must reinstall. Make the venv python pass the
# version probe (so it counts as usable) but FAIL `-m pip install`, which
# is exactly the "requirements changed and the reinstall failed" case.
cat > "$DATA5B/local-coder/.venv/bin/python" <<'FAILPIP'
#!/usr/bin/env bash
if [ "$1" = "-c" ]; then exit 0; fi
if [ "$1" = "-m" ]; then echo "pip install failed" >&2; exit 1; fi
echo "FAKE_PY_RAN arg=$1"
FAILPIP
chmod +x "$DATA5B/local-coder/.venv/bin/python"
echo "a-package-that-changed==9.9.9" > "$DATA5B/local-coder/requirements.installed.txt"
OUT="$(bash "$HOOK" "$DATA5B" /some/server.py 2>&1)"; RC=$?
if [ "$RC" -eq 1 ]; then
    pass "failed venv refresh exits 1 instead of launching a stale venv"
else
    fail "failed venv refresh exits 1 instead of launching a stale venv (got $RC)"
fi
if ! printf '%s' "$OUT" | grep -q "FAKE_PY_RAN"; then
    pass "failed venv refresh never execs the stale interpreter"
else
    fail "failed venv refresh never execs the stale interpreter (out=$OUT)"
fi


# --- Test 6: the hook must be DIRECTLY EXECUTABLE (no-shell spawn) ---
# Claude Code posix_spawn()s the MCP `command` directly — it does NOT run it
# through a shell. A script without a shebang (like hooks/run-hook.cmd, which
# is a shebang-less CMD/bash polyglot) fails with ENOEXEC when spawned that
# way. This test guards the real bug that broke the first smoke test: routing
# the MCP command through run-hook.cmd made the server unlaunchable.
if head -1 "$HOOK" | grep -q '^#!'; then
    pass "launch hook has a shebang (directly spawnable, no shell needed)"
else
    fail "launch hook has a shebang (directly spawnable, no shell needed)"
fi
if [ -x "$HOOK" ]; then pass "launch hook is executable"; else fail "launch hook is executable"; fi
# Prove it actually spawns without a shell (the ENOEXEC reproducer).
DATA6="$TEST_ROOT/data6"; make_fake_venv "$DATA6"
if python3 -c "
import subprocess, sys
try:
    p = subprocess.Popen(['$HOOK', '$DATA6', '/some/server.py'],
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL)
    out, _ = p.communicate(timeout=10)
    sys.exit(0 if b'FAKE_PY_RAN' in out else 1)
except OSError:
    sys.exit(1)
" 2>/dev/null; then
    pass "spawns directly without a shell (no ENOEXEC)"
else
    fail "spawns directly without a shell (no ENOEXEC)"
fi

if [ "$FAILURES" -gt 0 ]; then echo "STATUS: FAILED ($FAILURES)"; exit 1; fi
echo "STATUS: PASSED"
